# Node
node_modules/
frontend/dist/
frontend/.vite/
backend/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
.venv/
ml-service/venv/
ml-service/__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
ml-service/.cache/
uv-cache/

# ZenML local repo metadata / SQLite store
.zen/

# Env
.env
.env.local
*.env
!.env.example

# Data (large / private — see DATA_PIPELINE.md for versioning strategy)
data/raw/*
data/processed/*
data/validated/*
data/evaluation/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/validated/.gitkeep
!data/evaluation/.gitkeep

# Audio storage (local dev)
storage/audio/*
!storage/audio/.gitkeep

# MLflow / experiment artifacts
mlruns/
mlartifacts/

# Models
*.pt
*.bin
*.ckpt
ml-service/models/*
!ml-service/models/.gitkeep

# Vendored native tools (espeak-ng, fetched/extracted by scripts/setup_espeak.ps1 — not committed, ~37MB binary)
ml-service/vendor/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Logs
*.log
logs/

# MongoDB local data (mongodb-memory-server cache, local mongod data dir)
.mongodb-binaries/
mongo-data/
