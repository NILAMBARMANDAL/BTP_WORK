# Copy to .env and fill in. Never commit the real .env file.

# ---------- backend ----------
PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/btp_asr
# When set to "memory", backend spins up mongodb-memory-server for local dev
# instead of connecting to MONGO_URI. Do not use in production.
MONGO_MODE=memory
ML_SERVICE_URL=http://127.0.0.1:8000
# Comma-separated allowlist of frontend origins for CORS (production). Unset
# = any origin (fine for local dev only). e.g.:
# CORS_ORIGIN=https://frontend-three-psi-tz8kxezc8c.vercel.app
CORS_ORIGIN=
AUDIO_STORAGE_DIR=../storage/audio
MAX_AUDIO_UPLOAD_MB=25

# ---------- ml-service ----------
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000

# Whisper (faster-whisper) configuration — see ARCHITECTURE.md and GPU_SETUP.md
# "Model size findings". small/medium were observed to sometimes output
# wrong-script (Devanagari-like) transliteration instead of Bengali script for
# Bengali audio; large-v3 (int8 quantized) correctly outputs Bengali script
# and fits a 4GB GPU. This was checked on one synthetic TTS sample, not a
# rigorous benchmark — see GPU_SETUP.md for what still needs real evaluation.
WHISPER_MODEL_SIZE=large-v3
# cuda | cpu
WHISPER_DEVICE=cuda
# int8 | int8_float16 | float16 | float32 — pick based on available VRAM
WHISPER_COMPUTE_TYPE=int8_float16
WHISPER_LANGUAGE=bn
WHISPER_BEAM_SIZE=5

# Audio preprocessing toggles (each independently experimental — see RESEARCH.md)
PREPROC_RESAMPLE=true
PREPROC_TARGET_SR=16000
PREPROC_MONO=true
PREPROC_TRIM_SILENCE=false
PREPROC_VAD=false
PREPROC_NORMALIZE=false
PREPROC_DENOISE=false

# Phonetics: espeak-ng path (see ml-service/phonetics/README.md). Leave empty
# on Linux/Docker (apt-get install espeak-ng, found automatically via PATH).
# On Windows, run ml-service/scripts/setup_espeak.ps1 and paste the printed
# paths here. If unset and espeak-ng isn't on PATH, falls back automatically
# to the less-validated ITRANS heuristic — check phonetic_method() if unsure
# which is active.
ESPEAK_NG_EXE=
ESPEAK_NG_DATA_PATH=

# Candidate ranking weights (must sum to something sensible; kept explicit, not normalized silently)
RANKING_WEIGHT_ACOUSTIC=0.4
RANKING_WEIGHT_PHONETIC=0.4
RANKING_WEIGHT_SEMANTIC=0.1
RANKING_WEIGHT_CONTEXTUAL=0.1

# ---------- frontend ----------
VITE_BACKEND_URL=http://127.0.0.1:4000

# ---------- MLflow (added when Phase 9 begins) ----------
# MLFLOW_TRACKING_URI=

# ---------- Object storage (optional, later) ----------
# AWS_S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
